{
    "version": 2,
    "regions": ["lhr1"],
    "crons": [
        { "path": "/api/cron/mot-day-reminders", "schedule": "0 7 * * *" },
        { "path": "/api/cron/ga4-pool-check", "schedule": "30 8 * * *" },
        { "path": "/api/cron/website-stock-sync", "schedule": "15 6 * * *" },
        { "path": "/api/cron/unanswered-messages", "schedule": "*/10 * * * *" },
        { "path": "/api/cron/off-road-car-reminders", "schedule": "20 5 * * *" },
        { "path": "/api/cron/stale-car-reminders", "schedule": "30 5 * * *" }
    ],
    "outputDirectory": "dist/public",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}