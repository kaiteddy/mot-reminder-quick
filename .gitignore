# Dependencies
**/node_modules
.pnpm-store/

# Build outputs
dist/
build/
*.dist

# Environment variables
# Every .env variant. The enumerated list missed .env.bak and .env.bak-before-forge-removal,
# which sat untracked in the root holding live credentials — one `git add -A` from a repeat of
# the deploy_vercel.sh leak. A sample file is the only thing that may ever be committed.
.env*
!.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

